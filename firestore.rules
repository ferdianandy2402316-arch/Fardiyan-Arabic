rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny for all paths
    match /{document=**} {
      allow read, write: if false;
    }

    // User documents and all subcollections:
    // Strictly enforced so each user can ONLY read and write their own data.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // All subcollections under the user's document (progress, quizResults, notes, etc.)
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Read-only learning materials for authenticated users (mufrodat, hiwar, qawaid, qiraah)
    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
